# Copy to .env and fill in. .env is git-ignored.

# --- Google Cloud / BigQuery ---
# Project that runs (and is billed for) the queries. The GA4 source data is public.
GCP_PROJECT=your-gcp-project-id
# Dataset the models are written to (created if missing).
BQ_DATASET=marketing_analytics
# The GA4 public sample lives in the US multi-region, so the output dataset must too.
BQ_LOCATION=US
# Path to a service-account key. Leave unset to use `gcloud auth application-default login`.
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/key.json
# Safety cap per query, in bytes (default 50 GB).
BQ_MAX_BYTES_BILLED=50000000000

# --- GA4 model parameters ---
GA4_SOURCE_TABLE=bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*
GA4_START_DATE=20201101
GA4_END_DATE=20210131
# A user with no activity in this many days before GA4_END_DATE is flagged as churned.
CHURN_DAYS=30
# Week-over-week revenue change above +x is Expansion, below -x is Contraction.
TREND_THRESHOLD=0.10

# --- Microsoft MIND ---
# "small" (MIND-small, 50k users) or "large" (MIND, 1M users).
MIND_VARIANT=small
# Where the downloaded MIND files are unzipped (git-ignored).
MIND_DATA_DIR=data/mind
# A reader with no impressions in the last N days of the data is flagged Disengaged.
MIND_DISENGAGED_DAYS=2
# Minimum clicks, both before and during the impression log, for topic-drift scoring.
MIND_MIN_CLICKS=3
# A category whose share of a reader's clicks changes by this much (0.20 = 20 points)
# is labelled Drifting away / Growing interest.
MIND_DRIFT_THRESHOLD=0.20

# --- Salesforce (Developer Edition) ---
SF_USERNAME=you@example.com
SF_PASSWORD=your-password
# Settings > Reset My Security Token, in Salesforce. Emailed to you.
SF_SECURITY_TOKEN=your-token
# "login" for production / Developer Edition orgs, "test" for sandboxes.
SF_DOMAIN=login
# A Developer Edition org stores about 5 MB (~2,500 records), so only a sample is loaded.
SF_MAX_CONTACTS=400
SF_MAX_LEADS=200

# --- AI question layer ---
# Anthropic API key (or run `ant auth login` instead).
ANTHROPIC_API_KEY=your-anthropic-api-key
UCA_LLM_MODEL=claude-opus-5
# How many times a failing generated query is corrected and retried.
AI_MAX_SQL_ATTEMPTS=3
# Most rows any generated query may return.
AI_MAX_ROWS=200
# BigQuery remote embedding model for MIND semantic search (see docs/ai.md).
MIND_EMBEDDING_MODEL=mind_text_embedding
