<?xml version='1.0'?>
<!--
  Custom color palettes for the Tableau dashboards (see docs/reporting.md).
  Copy this file to "My Tableau Repository/Preferences.tps" and restart Tableau.
  The categorical order was checked for colorblind separation. Always assign colors in
  this fixed order and give "Other" the gray from "UCA Emphasis".
-->
<workbook>
  <preferences>
    <color-palette name="UCA Categorical" type="regular">
      <color>#2a78d6</color>
      <color>#eb6834</color>
      <color>#1baf7a</color>
      <color>#eda100</color>
      <color>#e87ba4</color>
      <color>#008300</color>
    </color-palette>
    <color-palette name="UCA Emphasis" type="regular">
      <color>#2a78d6</color>
      <color>#a8a7a2</color>
    </color-palette>
    <color-palette name="UCA Sequential Blue" type="ordered-sequential">
      <color>#cde2fb</color>
      <color>#9ec5f4</color>
      <color>#6da7ec</color>
      <color>#3987e5</color>
      <color>#256abf</color>
      <color>#184f95</color>
      <color>#0d366b</color>
    </color-palette>
    <color-palette name="UCA Trend (diverging)" type="ordered-diverging">
      <color>#d03b3b</color>
      <color>#f0efec</color>
      <color>#2a78d6</color>
    </color-palette>
  </preferences>
</workbook>
